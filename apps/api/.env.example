# Copy this file to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection string. On Supabase use the "Session pooler" string (IPv4),
# with your database password filled in.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# The kitchen's time zone. "Today", cut-offs and delivery times are all computed in this zone,
# whatever time zone the server or the browser is in.
KITCHEN_TIME_ZONE=Asia/Kolkata
