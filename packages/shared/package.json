{
  "name": "@fernleaf/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, schemas and constants shared by the web app and the API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
